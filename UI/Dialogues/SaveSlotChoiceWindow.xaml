<Window x:Class="GuildManager.UI.Dialogues.SaveSlotChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegarder"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F1A"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Dans quel emplacement sauvegarder ?"
                   Foreground="#F1EEE3" FontFamily="Georgia" FontSize="16"
                   Margin="0,0,0,16" TextWrapping="Wrap" />

        <Button x:Name="Slot1Button" Content="SLOT 1" Click="Slot1Button_Click"
                Margin="0,0,0,8" Padding="10" FontFamily="Georgia" FontSize="14" />
        <Button x:Name="Slot2Button" Content="SLOT 2" Click="Slot2Button_Click"
                Margin="0,0,0,8" Padding="10" FontFamily="Georgia" FontSize="14" />
        <Button x:Name="Slot3Button" Content="SLOT 3" Click="Slot3Button_Click"
                Padding="10" FontFamily="Georgia" FontSize="14" />
    </StackPanel>
</Window>
