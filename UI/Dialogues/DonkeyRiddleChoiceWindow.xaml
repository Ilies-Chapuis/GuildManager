<Window x:Class="GuildManager.UI.Dialogues.DonkeyRiddleChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="L'énigme de l'Âne"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F1A"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Que réponds-tu à l'Âne ?"
                   Foreground="#F1EEE3" FontFamily="Georgia" FontSize="18"
                   FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap" />

        <Button x:Name="GoldButton"
                Click="GoldButton_Click" Margin="0,0,0,10" Padding="10" FontFamily="Georgia" FontSize="15" />
