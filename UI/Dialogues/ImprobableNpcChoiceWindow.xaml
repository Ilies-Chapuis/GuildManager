<Window x:Class="GuildManager.UI.Dialogues.ImprobableNpcChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Une offre étrange"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F1A"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock x:Name="QuestionText"
                   Foreground="#F1EEE3" FontFamily="Georgia" FontSize="16"
                   Margin="0,0,0,18" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="YesButton" Content="Oui, j'accepte"
                    Click="YesButton_Click" Margin="0,0,10,0" Padding="14,8" FontFamily="Georgia" FontSize="14" />
            <Button x:Name="NoButton" Content="Non, je décline"
                    Click="NoButton_Click" Padding="14,8" FontFamily="Georgia" FontSize="14" />
        </StackPanel>
    </StackPanel>
</Window>
