<Window
    x:Class="GuildManager.UI.RecrutementsPageView.RecruitmentSuccessWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recrutement
    réussi" Width="500" Height="350" WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize" Background="#05030A">

    <Border
        Margin="15"
        Background="#D8C08A"
        BorderBrush="#8B6F3E"
        BorderThickness="3"
        CornerRadius="5">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--Title-->
            <TextBlock
                Grid.Row="0"
                Text="Recrutement réussi !"
                FontFamily="Georgia"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#3D2E18"
                HorizontalAlignment="Center"
                Margin="0,0,0,20" />

            <!--Message-->
            <TextBlock
                x:Name="RecruitmentMessageText"
                Grid.Row="1"
                FontFamily="Georgia"
                FontSize="20"
                Foreground="#3D2E18"
                TextWrapping="Wrap"
                TextAlignment="Center"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />

            <!--Buttons-->
            <Button
                Grid.Row="2"
                Content="Continuer"
                Width="150"
                Height="45"
                FontFamily="Georgia"
                FontSize="18"
                Foreground="#3D2E18"
                Background="#D8C08A"
                BorderBrush="#8B6F3E"
                BorderThickness="2"
                HorizontalAlignment="Center"
                Click="ContinueButton_Click" />
        </Grid>
    </Border>
</Window>