<UserControl x:Class="GuildManager.UI.RecrutementsPageView.UnitDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#05030A">

        <Border
            Width="700"
            Height="450"
            Background="#D8C08A"
            BorderBrush="#8B6F3E"
            BorderThickness="3"
            CornerRadius="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Nom de l'unité -->
                <TextBlock
                    x:Name="UnitNameText"
                    Grid.Row="0"
                    FontFamily="Georgia"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#3D2E18"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"/>

                <!-- Description -->
                <TextBlock
                    x:Name="UnitDescriptionText"
                    Grid.Row="1"
                    FontFamily="Georgia"
                    FontSize="20"
                    Foreground="#3D2E18"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"/>

                <!-- Niveau -->
                <TextBlock
                    x:Name="UnitLevelText"
                    Grid.Row="2"
                    FontFamily="Georgia"
                    FontSize="20"
                    Foreground="#3D2E18"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,10"/>

                <!-- Coût -->
                <TextBlock
                    x:Name="UnitCostText"
                    Grid.Row="3"
                    FontFamily="Georgia"
                    FontSize="20"
                    Foreground="#3D2E18"
                    HorizontalAlignment="Center"/>

                <!-- Bouton Recruter -->
                <Button
                    Grid.Row="4"
                    x:Name="RecruitButton"
                    Content="Recruter"
                    Width="150"
                    Height="50"
                    Margin="0,25,0,0"
                    FontFamily="Georgia"
                    FontSize="20"
                    Foreground="#3D2E18"
                    Background="#D8C08A"
                    BorderBrush="#8B6F3E"
                    BorderThickness="2"
                    Click="RecruitButton_Click" />
            </Grid>

        </Border>

    </Grid>

</UserControl>