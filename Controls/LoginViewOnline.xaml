<UserControl x:Class="GuildManager.UI.Login_Online.LoginViewOnline"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d">

    <!--
    UserControl.Resources:
    Stores reusable resources for this UserControl.

    LinearGradientBrush:
    Creates a color gradient.

    x:Key:
    Gives the resource a name so it can be reused.

    GradientStop:
    Defines one color of the gradient.

    Color:
    Sets the color.

    Offset:
    Sets the color's position:
    0 = start, 1 = end.
    -->

    <UserControl.Resources>

        <LinearGradientBrush x:Key="ParchmentBrush" StartPoint="0,0" EndPoint="1,0.15">
            <GradientStop Color="#E8D4A0" Offset="0" />
            <GradientStop Color="#F2E4BC" Offset="0.45" />
            <GradientStop Color="#E4CE94" Offset="0.75" />
            <GradientStop Color="#DEC98A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RollBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6E5127" Offset="0" />
            <GradientStop Color="#8B6F3E" Offset="0.35" />
            <GradientStop Color="#5A4526" Offset="0.7" />
            <GradientStop Color="#3D2E18" Offset="1" />
        </LinearGradientBrush>

        <!--
        Storyboard:
        Holds the parchment's animations.

        ScaleX:
        Opens the parchment horizontally.
        -->

        <Storyboard x:Key="UnrollStoryboard">

            <!--
            DoubleAnimation:
            Animates a numeric value.

            From:
            Starting value.

            To:
            Ending value.

            Duration:
            Length of the animation.

            QuadraticEase:
            Makes the animation feel more natural.

            EaseOut:
            The animation gradually slows down at the end.
            -->

            <DoubleAnimation
                Storyboard.TargetName="ParchmentScale"
                Storyboard.TargetProperty="ScaleX"
                From="0"
                To="1"
                Duration="0:0:1.3">

                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>

            </DoubleAnimation>

        </Storyboard>

    </UserControl.Resources>

    <!--
    Grid.Triggers:
    Fires an action when an event occurs.

    Loaded:
    Fires when the UserControl has finished loading.

    BeginStoryboard:
    Starts an animation.
    -->

    <Grid Background="#05030A">

        <Grid.Triggers>

            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource UnrollStoryboard}" />
            </EventTrigger>

        </Grid.Triggers>

        <Viewbox Stretch="Uniform">

            <Grid Width="1253" Height="705">

                <Image
                    Source="/GuildManager;component/Assets/Ruines.png"
                    Stretch="Fill"
                    Width="1253"
                    Height="705" />

                <Border
                    Width="850"
                    Height="300"
                    Background="{StaticResource ParchmentBrush}"
                    BorderBrush="#8B6F3E"
                    BorderThickness="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">

                    <!--
                    RenderTransform:
                    Visually alters the Border.

                    ScaleTransform:
                    Lets us change its size.

                    ScaleX:
                    Changes its width.

                    ScaleY:
                    Changes its height.
                    -->

                    <Border.RenderTransform>

                        <ScaleTransform
                            x:Name="ParchmentScale"
                            ScaleX="0"
                            ScaleY="1" />

                    </Border.RenderTransform>

                    <Grid Margin="0,-40,0,0">

                        <TextBlock
                            Text="CONNEXION EN LIGNE"
                            FontFamily="Georgia"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="#3D2E18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,50,0,0" />

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,100,0,0">

                            <TextBlock
                                Text="Pseudo"
                                FontFamily="Georgia"
                                FontSize="20"
                                Foreground="#3D2E18"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,5" />

                            <TextBox
                                x:Name="PseudoTextBox"
                                Width="300"
                                Height="35"
                                FontFamily="Georgia"
                                FontSize="18"
                                Padding="8,2"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />

                            <TextBlock
                                Text="Mot de passe"
                                FontFamily="Georgia"
                                FontSize="20"
                                Foreground="#3D2E18"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,5" />

                            <PasswordBox
                                x:Name="PasswordBox"
                                Width="300"
                                Height="35"
                                FontFamily="Georgia"
                                FontSize="18"
                                Padding="8,2"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />

                            <!--
                            The three buttons are grouped
                            horizontally on a single line.
                            -->

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,25,0,0">

                                <Button
                                    Content="Retour"
                                    Width="150"
                                    Height="45"
                                    FontFamily="Georgia"
                                    FontSize="20"
                                    Foreground="#3D2E18"
                                    Background="#D8C08A"
                                    BorderBrush="#8B6F3E"
                                    BorderThickness="2"
                                    Margin="0,0,10,0"
                                    Click="ReturnButton_Click" />

                                <Button
                                    Content="Se connecter"
                                    Width="180"
                                    Height="45"
                                    FontFamily="Georgia"
                                    FontSize="20"
                                    Foreground="#3D2E18"
                                    Background="#D8C08A"
                                    BorderBrush="#8B6F3E"
                                    BorderThickness="2"
                                    Margin="10,0,10,0"
                                    Click="LoginButton_Click" />

                                <Button
                                    Content="S'inscrire"
                                    Width="180"
                                    Height="45"
                                    FontFamily="Georgia"
                                    FontSize="20"
                                    Foreground="#3D2E18"
                                    Background="#D8C08A"
                                    BorderBrush="#8B6F3E"
                                    BorderThickness="2"
                                    Margin="10,0,0,0"
                                    Click="RegisterButton_Click" />

                            </StackPanel>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Viewbox>

    </Grid>

</UserControl>