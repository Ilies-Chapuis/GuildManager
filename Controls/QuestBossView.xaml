<UserControl x:Class="GuildManager.UI.QuestBoss.QuestBossView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d">

        <UserControl.Resources>
            <Style x:Key="Quest2BackButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="15,5" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="Quest2ActionButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="QuestBossValidateButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="3" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#3D2E18" />
            </Style>
        </UserControl.Resources>

        <Grid Background="#05030A">
            <Viewbox Stretch="Uniform">
                <Grid Width="1253" Height="705">

                    <Image
                        Source="/GuildManager;component/Assets/Menu_quetes2.png"
                        Stretch="Fill"
                        Width="1253"
                        Height="705" />

                    <Button
                        Content="Retour"
                        Style="{StaticResource Quest2BackButtonStyle}"
                        Click="ReturnButton_Click"
                        Width="150"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="30" />

                    <Canvas>
                        <!-- Nom + contraintes de la quête de boss du jour -->
                        <Border Canvas.Left="290" Canvas.Top="105"
                                Width="780" Height="30"
                                Background="#EFE0B8" BorderBrush="#8B6F3E" BorderThickness="2" CornerRadius="4">
                            <TextBlock x:Name="BossNameText"
                                       FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                       Foreground="#3D2E18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Colonne 1 : recrues disponibles aujourd'hui -->
                        <TextBlock Text="Recrues disponibles" Style="{StaticResource SectionLabelStyle}"
                                   Canvas.Left="290" Canvas.Top="150" />
                        <ListBox x:Name="AvailableRecruitListBox"
                                 Canvas.Left="290" Canvas.Top="175"
                                 Width="330" Height="280"
                                 SelectionMode="Single" />
                        <Button Content="Ajouter à l'équipe →"
                                Style="{StaticResource Quest2ActionButtonStyle}"
                                Canvas.Left="290" Canvas.Top="460" Width="330" Height="28"
                                Click="AddToTeamButton_Click" />

                        <!-- Colonne 2 : équipe actuellement formée -->
                        <TextBlock Text="Équipe envoyée (5 requis, dont 2 spéciaux min.)" Style="{StaticResource SectionLabelStyle}"
                                   Canvas.Left="690" Canvas.Top="150" />
                        <ListBox x:Name="TeamListBox"
                                 Canvas.Left="690" Canvas.Top="175"
                                 Width="330" Height="280"
                                 SelectionMode="Single" />
                        <Button Content="← Retirer de l'équipe"
                                Style="{StaticResource Quest2ActionButtonStyle}"
                                Canvas.Left="690" Canvas.Top="460" Width="330" Height="28"
                                Click="RemoveFromTeamButton_Click" />

                        <Border Canvas.Left="290" Canvas.Top="500"
                                Width="730" Height="95"
                                Background="#EFE0B8" BorderBrush="#8B6F3E" BorderThickness="2" CornerRadius="6">
                            <StackPanel Margin="14,8">
                                <TextBlock x:Name="SuccessRateText"
                                           FontFamily="Georgia" FontSize="15" FontWeight="Bold"
                                           Foreground="#3D2E18" />
                                <TextBlock x:Name="StatusText"
                                           Margin="0,6,0,0"
                                           FontFamily="Georgia" FontSize="13"
                                           Foreground="#8B1A1A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button
                            Content="Affronter le boss"
                            Width="220"
                            Height="45"
                            Canvas.Left="516"
                            Canvas.Top="612"
                            Style="{StaticResource QuestBossValidateButtonStyle}"
                            Click="SendTeamButton_Click" />

                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>
</UserControl>
