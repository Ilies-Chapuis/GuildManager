<UserControl x:Class="GuildManager.UI.The_LoadGame.LoadGameView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d">

    <UserControl.Resources>

        <!--
            ParchmentShadow = effet d'ombre utilisé sur le parchemin.
            DropShadowEffect permet de donner une profondeur visuelle à l'élément.
        -->
        <DropShadowEffect
            x:Key="ParchmentShadow"
            Color="Black"
            BlurRadius="20"
            ShadowDepth="5"
            Opacity="0.5" />

        <!--
            ParchmentBrush = dégradé utilisé pour donner
            un aspect parchemin à la feuille.
        -->
        <LinearGradientBrush
            x:Key="ParchmentBrush"
            StartPoint="0,0"
            EndPoint="1,0.15">

            <GradientStop Color="#E8D4A0" Offset="0" />
            <GradientStop Color="#F2E4BC" Offset="0.45" />
            <GradientStop Color="#E4CE94" Offset="0.75" />
            <GradientStop Color="#DEC98A" Offset="1" />

        </LinearGradientBrush>

        <!--
            RollBrush = dégradé utilisé pour les rouleaux
            du parchemin.
        -->
        <LinearGradientBrush
            x:Key="RollBrush"
            StartPoint="0,0"
            EndPoint="1,0">

            <GradientStop Color="#6E5127" Offset="0" />
            <GradientStop Color="#8B6F3E" Offset="0.35" />
            <GradientStop Color="#5A4526" Offset="0.7" />
            <GradientStop Color="#3D2E18" Offset="1" />

        </LinearGradientBrush>

        <!--
            LoadButtonStyle = style commun aux boutons de sauvegarde.
        -->
        <Style
            x:Key="LoadButtonStyle"
            TargetType="Button">

            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#3D2E18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <!--
                Trigger = change une propriété lorsqu'une condition est vraie.
                Ici, le bouton change lorsque la souris passe dessus.
            -->
            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">

                    <Setter
                        Property="Foreground"
                        Value="#8B1A1A" />

                    <Setter
                        Property="FontWeight"
                        Value="Bold" />

                    <Setter
                        Property="Cursor"
                        Value="Hand" />

                </Trigger>

                <!--
                    IsPressed = vrai lorsque le bouton est enfoncé.
                -->
                <Trigger Property="IsPressed" Value="True">

                    <Setter
                        Property="Foreground"
                        Value="#5A0E0E" />

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!--
        Grid principal.
        Le fond noir permet de garder le même environnement
        que LoginViewSolo.
    -->
    <Grid Background="Black">


        <!--
            Grid représentant le parchemin.
        -->
        <Grid
            Width="600"
            Height="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">


            <!--
                Rectangle = forme rectangulaire.

                Il représente le corps du parchemin.
            -->
            <Rectangle
                x:Name="Parchment"
                Fill="{StaticResource ParchmentBrush}"
                Width="600"
                Height="430"
                Stroke="#8B6F3E"
                StrokeThickness="4"
                RadiusX="15"
                RadiusY="15"
                Opacity="0.95"
                Effect="{StaticResource ParchmentShadow}" />


            <!--
                StackPanel = organise automatiquement
                les éléments les uns sous les autres.

                Orientation="Vertical"
                signifie que les éléments sont empilés
                de haut en bas.
            -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="450">


                <!-- Titre de l'écran de chargement -->
                <TextBlock
                    Text="CHARGER UNE PARTIE"
                    FontFamily="Georgia"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#3D2E18"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,0,0,25" />


                <!--
                    Slot 1

                    Pour l'instant, ce bouton est simplement
                    une représentation visuelle d'un emplacement
                    de sauvegarde.
                -->
                <Button
                    Content="SLOT 1"
                    Width="300"
                    Height="60"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LoadButtonStyle}"
                    Margin="10"
                    Click="Slot1Button_Click" />


                <!-- Slot 2 -->
                <Button
                    Content="SLOT 2"
                    Width="300"
                    Height="60"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LoadButtonStyle}"
                    Margin="10"
                    Click="Slot2Button_Click" />


                <!-- Slot 3 -->
                <Button
                    Content="SLOT 3"
                    Width="300"
                    Height="60"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LoadButtonStyle}"
                    Margin="10"
                    Click="Slot3Button_Click" />


                <!--
                    Retour permet de revenir à LoginViewSolo.
                -->
                <Button
                    Content="Retour"
                    Width="180"
                    Height="45"
                    HorizontalAlignment="Center"
                    Style="{StaticResource LoadButtonStyle}"
                    Margin="10,20,10,0"
                    Click="ReturnButton_Click" />

            </StackPanel>


            <!--
                Rouleau gauche du parchemin.
                Panel.ZIndex="1" permet de placer le rouleau
                au-dessus du rectangle.
            -->
            <Ellipse
                Panel.ZIndex="1"
                Fill="{StaticResource RollBrush}"
                Width="30"
                Height="430"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="-10,0,0,0"
                Stroke="#3D2E18"
                StrokeThickness="2"
                Effect="{StaticResource ParchmentShadow}" />


            <!-- Rouleau droit -->
            <Ellipse
                Panel.ZIndex="1"
                Fill="{StaticResource RollBrush}"
                Width="30"
                Height="430"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,-10,0"
                Stroke="#3D2E18"
                StrokeThickness="2"
                Effect="{StaticResource ParchmentShadow}" />

        </Grid>

    </Grid>

</UserControl>