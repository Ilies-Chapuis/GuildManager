<Window x:Class="GuildManager.LoginViewSolo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d">

        <Grid Background="Black">

        <Grid>

            <!-- La feuille -->
            <Rectangle
                Fill="#E8D29B"
                Width="500"
                Height="300" />

        <StackPanel
                Orientation= "Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin= "0,20,0,0" >

                <Button
                Content="Nouvelle Partie"
                Width="150"
                Height="50"
                HorizontalAlignment="Left"
                Margin="10" />

        <Button
                Content="Continuer"
                Width="150"
                Height="50"
                HorizontalAlignment="Left"
                Margin= "10" />

        <!--(Margin)60 pixel de décalage partant vers le bas (monte)-->
        <Button
                
                Content= "Charger"
                Width="150"
                Height="50"
                HorizontalAlignment="Left"
                Margin= "0,0,0,60"  />

        <Button
                Content= "Retour au Menu"
                Width="150"
                Height="50"
                HorizontalAlignment="Left"
                Margin="10" />

        </StackPanel>

        </Grid>

            <!-- Rouleau Gauche -->
            <Ellipse
                Fill="#B88A45"
                Width="40"
                Height="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="20,0,0,0" /> <!--Déplace le rouleau vers la gauche-->

            <!-- Rouleau Droit -->
            <Ellipse
                Fill="#B88A45"
                Width="40"
                Height="320"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,20,0" /> <!--Déplace le rouleau vers la droite-->

        </Grid>

</Window>