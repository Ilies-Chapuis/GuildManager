<UserControl x:Class="GuildManager.UI.Quest2.Quest2View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager"
        mc:Ignorable="d">

        <UserControl.Resources>
            <Style x:Key="Quest2BackButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="15,5" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="Quest2ActionButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="8,4" />
            </Style>

            <Style x:Key="Quest2ValidateButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="3" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#3D2E18" />
            </Style>
        </UserControl.Resources>

        <Grid Background="#05030A">
            <Viewbox Stretch="Uniform">
                <Grid Width="1253" Height="705">

                    <Image
                        Source="/GuildManager;component/Assets/Menu_quetes2.png"
                        Stretch="Fill"
                        Width="1253"
                        Height="705" />

                    <Button
                        Content="Retour"
                        Style="{StaticResource Quest2BackButtonStyle}"
                        Click="ReturnButton_Click"
                        Width="150"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="30" />

                    <Canvas>
                        <!-- Column 1: quests available today -->
                        <TextBlock Text="Quêtes disponibles" Style="{StaticResource SectionLabelStyle}"
                                   Canvas.Left="290" Canvas.Top="140" />
                        <ListBox x:Name="QuestListBox"
                                 Canvas.Left="290" Canvas.Top="165"
                                 Width="280" Height="280"
                                 SelectionMode="Single"
                                 SelectionChanged="QuestListBox_SelectionChanged" />

                        <!-- Column 2: recruits still available today -->
                        <TextBlock Text="Recrues disponibles" Style="{StaticResource SectionLabelStyle}"
                                   Canvas.Left="590" Canvas.Top="140" />
                        <ListBox x:Name="AvailableRecruitListBox"
                                 Canvas.Left="590" Canvas.Top="165"
                                 Width="230" Height="280"
                                 SelectionMode="Single" />
                        <Button Content="Ajouter à l'équipe →"
                                Style="{StaticResource Quest2ActionButtonStyle}"
                                Canvas.Left="590" Canvas.Top="450" Width="230" Height="28"
                                Click="AddToTeamButton_Click" />

                        <!-- Column 3: team currently assembled -->
                        <TextBlock Text="Équipe envoyée" Style="{StaticResource SectionLabelStyle}"
                                   Canvas.Left="840" Canvas.Top="140" />
                        <ListBox x:Name="TeamListBox"
                                 Canvas.Left="840" Canvas.Top="165"
                                 Width="230" Height="280"
                                 SelectionMode="Single" />
                        <Button Content="← Retirer de l'équipe"
                                Style="{StaticResource Quest2ActionButtonStyle}"
                                Canvas.Left="840" Canvas.Top="450" Width="230" Height="28"
                                Click="RemoveFromTeamButton_Click" />

                        <!-- Narrative description (lore) of the selected quest,
                             drawn from QuestFlavorRepository, plus the success
                             rate and status line. Solid parchment background
                             (not a translucent overlay) so text stays legible
                             over the busy wood-grain artwork behind it. -->
                        <Border Canvas.Left="290" Canvas.Top="490"
                                Width="780" Height="122"
                                Background="#EFE0B8" BorderBrush="#8B6F3E" BorderThickness="2" CornerRadius="6">
                            <StackPanel Margin="14,8">
                                <TextBlock x:Name="DescriptionText"
                                           FontFamily="Georgia" FontSize="12" FontStyle="Italic"
                                           Foreground="#3D2E18"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="SuccessRateText"
                                           Margin="0,8,0,0"
                                           FontFamily="Georgia" FontSize="15" FontWeight="Bold"
                                           Foreground="#3D2E18" />

                                <TextBlock x:Name="StatusText"
                                           Margin="0,4,0,0"
                                           FontFamily="Georgia" FontSize="13"
                                           Foreground="#8B1A1A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button
                            Content="Envoyer l'équipe"
                            Width="220"
                            Height="45"
                            Canvas.Left="516"
                            Canvas.Top="618"
                            Style="{StaticResource Quest2ValidateButtonStyle}"
                            Click="SendTeamButton_Click" />

                    </Canvas>      

                </Grid>
            </Viewbox>
        </Grid>
</UserControl>
