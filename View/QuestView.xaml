<UserControl x:Class="GuildManager.UI.Quest.QuestView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuildManager">

        <UserControl.Resources>

            <Style x:Key="QuestBackButtonStyle" TargetType="Button" >
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="#3D2E18" />
                <Setter Property="Background" Value="#D8C08A" />
                <Setter Property="BorderBrush" Value="#8B6F3E" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="15,5" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </UserControl.Resources>

        <Grid Background="#05030A">
            <Viewbox Stretch="Uniform">
                <Grid Width="1253" Height="705">
                    <Image x:Name="Menu_quêtes"
                        Source="/GuildManager;component/Assets/Menu_quêtes.png"
                        Stretch="Fill"
                        Width="1253"
                        Height="705" />
                    <Canvas>
                        <Button
                            Width="190"
                            Height="270"
                            Canvas.Left="845"
                            Canvas.Top="210"
                            Background="Transparent"
                            Click="Quest2Button_Click" />

                        <Button
                            Width="190"
                            Height="270"
                            Canvas.Left="637"
                            Canvas.Top="210"
                            Background="Transparent"
                            Click="QuestAnnexesButton_Click"/>

                        <Button
                            Width="190"
                            Height="275"
                            Canvas.Left="427"
                            Canvas.Top="205"
                            Background="Transparent"
                            Click="QuestBossButton_Click"/>
                    </Canvas>
                    <Button
                        Content="Retour"
                        Style="{StaticResource QuestBackButtonStyle}"
                        Click="ReturnButton_Click"
                        Width="150"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="30" />
                </Grid>
            </Viewbox>
        </Grid>
</UserControl>